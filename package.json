{
  "name": "onlyideas-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4182",
    "server": "node server/main.mjs",
    "build": "tsc --noEmit && vite build && node tools/native/build-reader.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run test:renderer && npm run build",
    "native:sync": "npm run build && cap sync",
    "android:debug": "npm run native:sync && cd android && ./gradlew --no-daemon --max-workers=2 :app:assembleDebug",
    "predev": "node tools/build-document-renderer.mjs",
    "prebuild": "node tools/build-document-renderer.mjs",
    "test:renderer": "node tools/build-document-renderer.mjs && node tools/check-document-renderer.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@apple/app-store-server-library": "3.1.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.0",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "8.0.0",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "google-auth-library": "11.1.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.41.0",
    "mathpix-markdown-it": "3.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.28.2",
    "jsdom": "27.0.0",
    "path-browserify": "1.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "mathpix-markdown-it": {
      "markdown-it": "12.3.2"
    },
    "postcss": "8.5.28",
    "uuid": "11.1.1",
    "linkify-it": "5.0.2"
  }
}
