{
  "name": "onlyideas-app",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4182",
    "server": "node server/main.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "native:sync": "npm run build && cap sync",
    "android:debug": "npm run native:sync && cd android && ./gradlew --no-daemon --max-workers=2 :app:assembleDebug"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.0",
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.0.0",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.5.1",
    "@capacitor/filesystem": "8.1.0",
    "@capacitor/ios": "8.5.1",
    "@capacitor/share": "8.0.0",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.41.0",
    "mathpix-markdown-it": "3.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.5",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
